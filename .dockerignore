# Ignore node modules and build artifacts at root (if any)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore frontend build output (we copy from build stage instead)
Ecommerce-Frontend/build

# VCS
.git
.gitignore

# OS
.DS_Store
Thumbs.db

# Env files except the one CI writes at repo root
!.env
.env.*
